{
  "name": "dashboard",
  "version": "1.0.13-rc.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "rc": "node ../scripts/bump-version.mjs",
    "rc:minor": "node ../scripts/bump-version.mjs minor",
    "rc:major": "node ../scripts/bump-version.mjs major",
    "release": "node ../scripts/release.mjs",
    "release:major": "node ../scripts/release.mjs major",
    "release:patch": "node ../scripts/release.mjs patch",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.12.7"
  },
  "devDependencies": {
    "wrangler": "^4.4.0"
  }
}
