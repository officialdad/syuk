# Copy to .env and fill in. gen_secrets.sh reads this to build firmware/smart_cone/secrets.h
# HiveMQ Cloud cluster (TLS, port 8883)
CLUSTER_URL=xxxxxxxx.s1.eu.hivemq.cloud
CLUSTER_USERNAME=smartcone
CLUSTER_PASSWORD=changeme
# ntfy.sh topic — any unguessable string
NTFY_TOPIC=smartcone-alerts-changeme
